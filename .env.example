# Sanity CMS
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Optional: Enable draft preview mode
# SANITY_TOKEN=your_read_token

# Google Tag Manager — container ID for analytics/marketing tags.
# Leave unset to disable GTM (e.g. local dev). Set in the Cloudflare Pages
# project environment variables for production. Not secret (visible in page source).
# PUBLIC_GTM_ID=GTM-XXXXXXX

# Cookiebot — "Domain Group ID" (a UUID) from the Cookiebot dashboard.
# Enables the cookie consent banner + Google Consent Mode v2. Leave unset to
# disable the banner. Not secret (visible in page source).
# PUBLIC_COOKIEBOT_ID=00000000-0000-0000-0000-000000000000
