# Sanity CMS
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Optional: Enable draft preview mode
# SANITY_TOKEN=your_read_token

# Google Tag Manager — container ID for analytics/marketing tags.
# Leave unset to disable GTM (e.g. local dev). Set in the Cloudflare Pages
# project environment variables for production. Not secret (visible in page source).
# PUBLIC_GTM_ID=GTM-XXXXXXX

# Cookiebot — "Domain Group ID" (a UUID) from the Cookiebot dashboard.
# Enables the cookie consent banner + Google Consent Mode v2. Leave unset to
# disable the banner. Not secret (visible in page source).
# PUBLIC_COOKIEBOT_ID=00000000-0000-0000-0000-000000000000

# Contact form (FormSubmit) — optional overrides. Not secret (visible in page source).
# By default the form sends to the Contact Email in Sanity Site Settings.
# PUBLIC_CONTACT_FORM_EMAIL sends submissions to this address INSTEAD, without
# changing the email shown on the site — use it on a preview deploy to test the
# form with a mailbox you control. PUBLIC_CONTACT_FORM_CC copies every
# submission to a second address. Any new recipient must click FormSubmit's
# "Activate Form" email (sent on the first submission) before mail is delivered.
# PUBLIC_CONTACT_FORM_EMAIL=you@example.com
# PUBLIC_CONTACT_FORM_CC=you@example.com
