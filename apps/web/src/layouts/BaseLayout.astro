---
import { SEO } from 'astro-seo';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BookingOverlay from '@components/BookingOverlay.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { sanityClient } from '@lib/sanity';
import { siteSettingsQuery } from '@lib/queries';
import { sanityImageUrl } from '@lib/image';
import type { SiteSettings } from '@foxhue/shared';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  transparentHeader?: boolean;
}

const { title, description, ogImage, transparentHeader = false } = Astro.props;

// Google Tag Manager container ID (e.g. "GTM-XXXXXXX").
// Set PUBLIC_GTM_ID in the environment to enable GTM; left unset (e.g. local
// dev) the snippet is omitted entirely. The ID is not secret — it appears in
// the page source — so PUBLIC_ exposure is expected.
const gtmId = import.meta.env.PUBLIC_GTM_ID;

// Cookiebot consent banner — "Domain Group ID" (a UUID) from the Cookiebot
// dashboard. Set PUBLIC_COOKIEBOT_ID to enable the cookie consent banner +
// Google Consent Mode v2. Left unset, no banner loads (GTM still defaults to
// consent "denied" below, so no non-essential cookies are set either way).
const cookiebotId = import.meta.env.PUBLIC_COOKIEBOT_ID;

const settings: SiteSettings = await sanityClient.fetch(siteSettingsQuery);

const siteTitle = title
  ? `${title} | ${settings?.siteName ?? 'MARR Laser & Skin Clinic'}`
  : settings?.siteName ?? 'MARR Laser & Skin Clinic';

const siteDescription =
  description ?? settings?.defaultSeo?.description ?? '';

const siteOgImage =
  ogImage ??
  (settings?.defaultSeo?.ogImage
    ? sanityImageUrl(settings.defaultSeo.ogImage, 1200, 630)
    : undefined);

const jsonLd = settings
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: settings.siteName,
      description: siteDescription,
      ...(settings.contactEmail && { email: settings.contactEmail }),
      ...(settings.contactPhone && {
        telephone: settings.contactPhone,
      }),
      ...(settings.address && {
        address: {
          '@type': 'PostalAddress',
          streetAddress: settings.address,
        },
      }),
      ...(settings.openingHours?.length && {
        openingHoursSpecification: settings.openingHours
          .filter((h) => !h.closed)
          .map((h) => ({
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: h.day,
            opens: h.open,
            closes: h.close,
          })),
      }),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Consent order matters and must come before any tags fire:
      1. Cookiebot loader (first script in <head>) — blocks non-essential
         trackers until the visitor chooses.
      2. Consent Mode v2 default = denied — so GTM/Google tags collect nothing
         (cookieless modelled mode) until consent is granted.
      3. Consent bridge — maps Cookiebot's choice to Google's consent signals
         (works on the free tier regardless of Cookiebot's auto-signalling).
      4. Google Tag Manager.
    */}
    {cookiebotId && (
      <script
        id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid={cookiebotId}
        data-blockingmode="auto"
        type="text/javascript"
        is:inline
      />
    )}

    {gtmId && (
      <!-- Consent Mode v2 default state -->
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'denied',personalization_storage:'denied',security_storage:'granted',wait_for_update:500});gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',true);`} />
    )}

    {cookiebotId && gtmId && (
      <!-- Bridge Cookiebot consent → Google Consent Mode -->
      <script is:inline set:html={`window.addEventListener('CookiebotOnConsentReady',function(){if(typeof Cookiebot==='undefined'||!Cookiebot.consent)return;var c=Cookiebot.consent;gtag('consent','update',{ad_storage:c.marketing?'granted':'denied',ad_user_data:c.marketing?'granted':'denied',ad_personalization:c.marketing?'granted':'denied',analytics_storage:c.statistics?'granted':'denied',functionality_storage:c.preferences?'granted':'denied',personalization_storage:c.preferences?'granted':'denied'});});`} />
    )}

    {gtmId && (
      <!-- Google Tag Manager -->
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
      <!-- End Google Tag Manager -->
    )}

    <SEO
      title={siteTitle}
      description={siteDescription}
      {...(siteOgImage && {
        openGraph: {
          basic: {
            title: siteTitle,
            type: 'website',
            image: siteOgImage,
          },
        },
      })}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.phorest.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />
    <!-- TODO: swap heading to Cangste when licensed webfont is available -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Noto+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>

  <body>
    {gtmId && (
      <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
      <!-- End Google Tag Manager (noscript) -->
    )}
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>
    <Header
      siteName={settings?.siteName ?? 'MARR Laser & Skin Clinic'}
      logo={settings?.logo}
      transparentHeader={transparentHeader}
    />

    <main id="main-content" class:list={[{ 'main--transparent-hero': transparentHeader }]}>
      <slot />
    </main>

    <Footer
      siteName={settings?.siteName ?? 'MARR Laser & Skin Clinic'}
      contactEmail={settings?.contactEmail}
      contactPhone={settings?.contactPhone}
      address={settings?.address}
      socialLinks={settings?.socialLinks}
    />

    <WhatsAppButton />
    <BookingOverlay />

    <script>
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        reveals.forEach((el) => observer.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .main--transparent-hero {
    margin-top: 0;
    padding-top: 0;
  }

  .skip-link:focus {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 9999;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary);
    color: var(--color-white);
    text-decoration: none;
    border-radius: var(--radius-sm);
    width: auto;
    height: auto;
    clip: auto;
    white-space: normal;
    overflow: visible;
  }
</style>
