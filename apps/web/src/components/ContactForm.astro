---
interface Props {
  /** Clinic contact email from Sanity Site Settings — the default recipient. */
  email?: string;
}

const { email } = Astro.props;

// Optional overrides, set as environment variables on the host (see README):
// - PUBLIC_CONTACT_FORM_EMAIL sends submissions to this address INSTEAD of the
//   Sanity contact email, without changing the address shown on the page. Use
//   it on a preview deploy to test the form with a mailbox you control.
// - PUBLIC_CONTACT_FORM_CC copies every submission to this address as well.
// Neither is secret (both appear in the page source), hence the PUBLIC_ prefix.
// A new recipient must be activated with FormSubmit before it receives mail:
// the first submission triggers an "Activate Form" email to that address.
const overrideEmail = import.meta.env.PUBLIC_CONTACT_FORM_EMAIL?.trim();
const ccEmail = import.meta.env.PUBLIC_CONTACT_FORM_CC?.trim();

const recipient = overrideEmail || email?.trim();
const formAction = recipient ? `https://formsubmit.co/${recipient}` : undefined;
---

<section class="contact-section" aria-labelledby="contact-heading">
  <div class="container form-container">
    <h2 id="contact-heading" class="section-heading">Get in Touch</h2>
    {formAction ? (
    <form
      action={formAction}
      method="POST"
      class="contact-form"
    >
      <!-- formsubmit.co configuration -->
      <input type="hidden" name="_next" value={`${Astro.url.origin}/thank-you/`} />
      <input type="hidden" name="_subject" value="New contact form submission" />
      {/*
        FormSubmit's reCAPTCHA is deliberately off. With it on, pressing Send
        took the visitor off-site to a FormSubmit "I'm not a robot" page and
        nothing was sent unless they ticked the box, which silently lost
        enquiries from paid traffic. Spam protection is the honeypot below.
        If spam becomes a problem, do not switch this back on: move to an
        on-site form with an invisible check (e.g. Cloudflare Turnstile).
      */}
      <input type="hidden" name="_captcha" value="false" />
      {ccEmail && <input type="hidden" name="_cc" value={ccEmail} />}
      <!-- Honeypot field for spam prevention -->
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

      <div class="form-group">
        <label for="contact-name" class="form-label">
          Name <span class="required" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          autocomplete="name"
          placeholder="Your full name"
          class="form-input"
        />
      </div>

      <div class="form-group">
        <label for="contact-email" class="form-label">
          Email <span class="required" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="form-input"
        />
      </div>

      <div class="form-group">
        <label for="contact-phone" class="form-label">Phone</label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          autocomplete="tel"
          placeholder="+44 7700 900000"
          class="form-input"
        />
      </div>

      <div class="form-group">
        <label for="contact-subject" class="form-label">Subject</label>
        <input
          type="text"
          id="contact-subject"
          name="subject"
          placeholder="How can we help?"
          class="form-input"
        />
      </div>

      <div class="form-group form-group--full">
        <label for="contact-message" class="form-label">
          Message <span class="required" aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="5"
          placeholder="Tell us more about your enquiry..."
          class="form-input form-textarea"
        ></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="form-submit">
          Send Message
        </button>
      </div>
    </form>
    ) : (
      <p class="form-unavailable">
        Our online form is unavailable at the moment. Please call, WhatsApp or
        email us using the details on this page.
      </p>
    )}
  </div>
</section>

<style>
  .contact-section {
    padding-block: var(--space-16);
  }

  .form-container {
    max-width: var(--max-width-narrow);
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-heading-light);
    color: var(--color-neutral-900);
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .form-unavailable {
    text-align: center;
    color: var(--color-neutral-700);
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-neutral-700);
  }

  .required {
    color: var(--color-error);
  }

  .form-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-neutral-900);
    background-color: var(--color-white);
    border: 1px solid var(--color-neutral-300);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input::placeholder {
    color: var(--color-neutral-400);
  }

  .form-input:hover {
    border-color: var(--color-neutral-400);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .form-input:invalid:not(:placeholder-shown) {
    border-color: var(--color-error);
  }

  .form-textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-start;
  }

  .form-submit {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-body-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-white);
    background-color: var(--color-secondary);
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-submit:hover {
    background-color: var(--color-secondary-dark);
    box-shadow: var(--shadow-md);
  }

  .form-submit:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .form-submit:active {
    transform: translateY(1px);
  }

  /* Tablet and up: 2-column grid for short fields */
  @media (min-width: 768px) {
    .contact-form {
      grid-template-columns: repeat(2, 1fr);
    }

    .form-group--full {
      grid-column: 1 / -1;
    }

    .form-actions {
      grid-column: 1 / -1;
    }
  }
</style>
