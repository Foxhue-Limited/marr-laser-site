# Cloudflare Pages security headers.
#
# Cloudflare Pages reads this file from the root of the build output; files in
# apps/web/public/ are copied to dist/ at build time, so this lands at dist/_headers.
# (Cloudflare Pages ignores vercel.json — these headers replace the ones defined
# there, which were never applied on the live Cloudflare-served site.)
#
# CSP NOTE: the policy below whitelists Google Tag Manager + the common campaign
# stack (GA4, Google Ads, Meta Pixel) + the Cookiebot consent banner. Any OTHER
# tag type added later via GTM (e.g. LinkedIn Insight, TikTok Pixel, Hotjar)
# loads from a domain not listed here and will be silently BLOCKED until its
# domain is added below. Because the client manages tags in GTM but cannot edit
# this repo, route any new tag types through the dev/agency so the CSP can be
# updated.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: payment=(self "https://www.phorest.com")
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://ssl.google-analytics.com https://connect.facebook.net https://elfsightcdn.com https://*.elfsight.com; style-src 'self' 'unsafe-inline' https://consentcdn.cookiebot.com https://fonts.googleapis.com https://tagmanager.google.com https://*.elfsight.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://imgsct.cookiebot.com https://consent.cookiebot.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.g.doubleclick.net https://www.google.com https://www.google.co.uk https://www.facebook.com https://cdn.sanity.io https://img.youtube.com https://*.cdninstagram.com https://*.fbcdn.net https://*.elfsightcdn.com data:; frame-src https://consentcdn.cookiebot.com https://www.googletagmanager.com https://td.doubleclick.net https://*.doubleclick.net https://www.phorest.com https://phorest.com https://www.youtube-nocookie.com https://*.elfsight.com; frame-ancestors 'none'; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://stats.g.doubleclick.net https://connect.facebook.net https://www.facebook.com https://*.sanity.io https://*.apicdn.sanity.io https://*.elfsight.com https://elfsightcdn.com
